{
  "name": "conventionalize-monorepo",
  "version": "1.0.0",
  "description": "Diff to Conventional Commit Builder monorepo (CLI + VS Code Extension + Core Engine)",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build:core && npm run build:cli && npm run build:vscode",
    "build:core": "npm run build --workspace=@conventionalize/core",
    "build:cli": "npm run build --workspace=conventionalize",
    "build:vscode": "npm run build --workspace=conventionalize-vscode",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:vscode": "npm run build:vscode && vsce package --no-git-tag-version --no-dependencies",
    "prepare": "npm run build:core"
  },
  "keywords": [
    "git",
    "conventional-commits",
    "ai",
    "cli",
    "vscode-extension",
    "diff",
    "commit-generator",
    "productivity"
  ],
  "author": "akil4",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
